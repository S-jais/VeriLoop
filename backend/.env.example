# VeriLoop Backend — Environment Variables Template
# Copy this file to .env and fill in real values. NEVER commit .env.

# ─── Nebius Token Factory ────────────────────────────────────────────────────
NEBIUS_API_KEY=
NEBIUS_API_BASE=https://api.tokenfactory.us-central1.nebius.com/v1

# Primary NVIDIA model via Nebius Token Factory:
# Verified on Nebius Token Factory:
#   nvidia/Nemotron-3_5-Lightning
PROBE_MODEL=nvidia/Nemotron-3_5-Lightning
DIAGNOSIS_MODEL=nvidia/Nemotron-3_5-Lightning
JUDGE_MODEL=nvidia/Nemotron-3_5-Lightning
NEBIUS_PRIMARY_MODEL=nvidia/Nemotron-3_5-Lightning

# Optional: Fast model for low-latency tasks / fallback
NEBIUS_FAST_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# ─── Tavily Evidence Research ─────────────────────────────────────────────────
TAVILY_API_KEY=

# ─── Database ─────────────────────────────────────────────────────────────────
# Default: SQLite for local dev
DATABASE_URL=sqlite+aiosqlite:///./veriloop.db

# For production (PostgreSQL example):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/veriloop

# ─── Application ──────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Optional Settings ────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Demo mode: enables reset-demo endpoint
DEMO_MODE=true
