# VeriLoop Backend — Environment Variables Template
# Copy this file to .env and fill in real values. NEVER commit .env.

# ─── Nebius Token Factory ────────────────────────────────────────────────────
NEBIUS_API_KEY=

# Primary NVIDIA model via Nebius Token Factory
# Options (check https://api.tokenfactory.nebius.com/v1/models for current list):
#   nvidia/llama-3.1-nemotron-70b-instruct
#   meta-llama/Llama-3.1-70B-Instruct
#   meta-llama/Meta-Llama-3.1-70B-Instruct
NEBIUS_PRIMARY_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Optional: A faster/smaller model for lightweight tasks (classification, summarization)
NEBIUS_FAST_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# ─── Tavily Evidence Research ─────────────────────────────────────────────────
TAVILY_API_KEY=

# ─── Database ─────────────────────────────────────────────────────────────────
# Default: SQLite for local dev
DATABASE_URL=sqlite+aiosqlite:///./veriloop.db

# For production (PostgreSQL example):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/veriloop

# ─── Application ──────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Optional Settings ────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Demo mode: enables reset-demo endpoint
DEMO_MODE=true
