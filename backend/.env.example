# VeriLoop Backend — Environment Variables Template
# Copy this file to .env and fill in real values. NEVER commit .env.

# ─── Nebius Token Factory ────────────────────────────────────────────────────
NEBIUS_API_KEY=
NEBIUS_API_BASE=https://api.tokenfactory.us-central1.nebius.com/v1

# NVIDIA Foundation Models via Nebius Token Factory:
# - nemotron-3-nano-30b-a3b: Probe generation, candidate drafting, fast triage
# - nemotron-3-ultra-550b-a55b: Root cause diagnosis, causal failure analysis
# - nemotron-3-super-120b-a12b: Primary reasoning, regression judging & holdout certification
PROBE_MODEL=nvidia/nemotron-3-nano-30b-a3b
DIAGNOSIS_MODEL=nvidia/nemotron-3-ultra-550b-a55b
JUDGE_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_PRIMARY_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_FAST_MODEL=nvidia/nemotron-3-nano-30b-a3b

# ─── Tavily Evidence Research ─────────────────────────────────────────────────
TAVILY_API_KEY=

# ─── Database ─────────────────────────────────────────────────────────────────
# Default: SQLite for local dev
DATABASE_URL=sqlite+aiosqlite:///./veriloop.db

# For production (PostgreSQL example):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/veriloop

# ─── Application ──────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Optional Settings ────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Demo mode: enables reset-demo endpoint
DEMO_MODE=true
